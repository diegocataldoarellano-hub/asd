# Servidor
PORT=3000
PUBLIC_URL=https://tu-dominio.com

# Twilio WhatsApp (https://console.twilio.com)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Sandbox: whatsapp:+14155238886 | Producción: tu número aprobado
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Solo estos números pueden consultar (formato E.164, separados por coma)
# Ejemplo: whatsapp:+5215512345678
ALLOWED_WHATSAPP_NUMBERS=

# GitHub (lectura de repos, PRs, Actions)
GITHUB_TOKEN=

# Webhook GitHub (opcional, para avisos automáticos)
GITHUB_WEBHOOK_SECRET=
